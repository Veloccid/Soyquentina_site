---
import '@fontsource/figtree/300.css';
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import Busto from '../components/Busto.astro';
import { SITO, MENU, linkWhatsApp } from '../config';

interface Props {
	titolo?: string; // titolo della pagina (senza il nome del sito)
	descrizione?: string;
	immagine?: string; // immagine per l'anteprima del link
}

const { titolo, descrizione = SITO.descrizione, immagine = '/og-image.png' } = Astro.props;
const titoloCompleto = titolo ? `${titolo} | ${SITO.nome}` : SITO.titolo;
const urlPagina = new URL(Astro.url.pathname, SITO.url).href;
const urlImmagine = new URL(immagine, SITO.url).href;
const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
const anno = new Date().getFullYear();
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{titoloCompleto}</title>
		<meta name="description" content={descrizione} />
		<link rel="canonical" href={urlPagina} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITO.nome} />
		<meta property="og:title" content={titoloCompleto} />
		<meta property="og:description" content={descrizione} />
		<meta property="og:url" content={urlPagina} />
		<meta property="og:image" content={urlImmagine} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="it_IT" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="salta" href="#contenuto">Vai al contenuto</a>

		<header class="testata">
			<a class="marchio" href="/" aria-label="SoyQuentina, home">
				<Busto altezza={38} alt="" />
				<span>SoyQuentina</span>
			</a>

			<nav class="menu-largo" aria-label="Menu principale">
				{
					MENU.map((voce) => (
						<a href={voce.href} aria-current={percorso.startsWith(voce.href) ? 'page' : undefined}>
							{voce.testo}
						</a>
					))
				}
			</nav>

			<details class="menu-piccolo">
				<summary>Menu</summary>
				<nav aria-label="Menu principale">
					{
						MENU.map((voce) => (
							<a href={voce.href} aria-current={percorso.startsWith(voce.href) ? 'page' : undefined}>
								{voce.testo}
							</a>
						))
					}
				</nav>
			</details>
		</header>

		<main id="contenuto">
			<slot />
		</main>

		<footer class="piede">
			<div class="piede-griglia">
				<div>
					<Busto altezza={56} alt="" />
					<p class="piede-dove">Homelab a {SITO.zona}<br />visite su appuntamento</p>
				</div>
				<nav aria-label="Pagine">
					<a href="/shop">Shop</a>
					<a href="/laboratori">Laboratori</a>
					<a href="/commissioni">Commissioni</a>
					<a href="/gift-card">Gift card</a>
					<a href="/chi-sono">Chi sono</a>
				</nav>
				<nav aria-label="Contatti">
					<a href={SITO.instagram} target="_blank" rel="noopener">Instagram {SITO.instagramNome}</a>
					<a href={linkWhatsApp('Ciao Quentina!')} target="_blank" rel="noopener">Scrivimi su WhatsApp</a>
				</nav>
				<nav aria-label="Informazioni legali">
					<a href="/spedizioni-e-resi">Spedizioni e resi</a>
					<a href="/termini-di-vendita">Termini di vendita</a>
					<a href="/privacy">Privacy e cookie</a>
				</nav>
			</div>
			<p class="piede-legale">
				© {anno} {SITO.ragioneSociale || SITO.nome}
				{SITO.partitaIva ? ` — P.IVA ${SITO.partitaIva}` : ' — P.IVA da inserire'}
			</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bianco: #ffffff;
		--rosa: #fddcd7;
		--nero: #000000;
		--nero-tenue: rgba(0, 0, 0, 0.62);
		--linea: 1.5px solid var(--nero);
		--larghezza: 1180px;
		--margine: clamp(16px, 4vw, 40px);
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		-webkit-text-size-adjust: 100%;
	}
	body {
		margin: 0;
		background: var(--bianco);
		color: var(--nero);
		font-family: 'Figtree', system-ui, sans-serif;
		font-weight: 300;
		font-size: 1.0625rem;
		line-height: 1.6;
	}
	img {
		max-width: 100%;
	}
	a {
		color: inherit;
	}
	h1,
	h2,
	h3 {
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0;
	}
	h1 {
		font-size: clamp(2.4rem, 6vw, 4.4rem);
	}
	h2 {
		font-size: clamp(1.8rem, 3.6vw, 2.6rem);
	}
	h3 {
		font-size: 1.3rem;
		letter-spacing: -0.01em;
	}
	p {
		margin: 0;
	}
	:focus-visible {
		outline: 2px solid var(--nero);
		outline-offset: 3px;
	}

	.contenitore {
		max-width: var(--larghezza);
		margin: 0 auto;
		padding: 0 var(--margine);
	}
	.testo-breve {
		max-width: 60ch;
	}
	.tenue {
		color: var(--nero-tenue);
	}

	/* pulsanti */
	.bottone {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 48px;
		padding: 0 26px;
		border-radius: 999px;
		border: var(--linea);
		background: var(--nero);
		color: var(--bianco);
		font: inherit;
		font-weight: 400;
		text-decoration: none;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	.bottone:hover {
		background: var(--bianco);
		color: var(--nero);
	}
	.bottone.chiaro {
		background: transparent;
		color: var(--nero);
	}
	.bottone.chiaro:hover {
		background: var(--nero);
		color: var(--bianco);
	}
	.bottoni {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.salta {
		position: absolute;
		left: -9999px;
	}
	.salta:focus {
		left: 16px;
		top: 16px;
		z-index: 10;
		background: var(--bianco);
		padding: 8px 12px;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<style>
	.testata {
		max-width: var(--larghezza);
		margin: 0 auto;
		padding: 18px var(--margine);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}
	.marchio {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		font-size: 1.35rem;
		font-weight: 400;
		letter-spacing: -0.01em;
	}
	.menu-largo {
		display: flex;
		gap: 28px;
	}
	.menu-largo a,
	.menu-piccolo a {
		text-decoration: none;
		font-weight: 400;
	}
	.menu-largo a:hover,
	.menu-largo a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 1.5px;
	}
	.menu-piccolo {
		display: none;
		position: relative;
	}
	.menu-piccolo summary {
		list-style: none;
		cursor: pointer;
		border: var(--linea);
		border-radius: 999px;
		padding: 6px 18px;
		font-weight: 400;
	}
	.menu-piccolo summary::-webkit-details-marker {
		display: none;
	}
	.menu-piccolo nav {
		position: absolute;
		right: 0;
		top: calc(100% + 10px);
		z-index: 5;
		background: var(--bianco);
		border: var(--linea);
		border-radius: 20px;
		padding: 10px 0;
		min-width: 200px;
		display: flex;
		flex-direction: column;
	}
	.menu-piccolo nav a {
		padding: 10px 22px;
	}
	.menu-piccolo nav a[aria-current='page'] {
		background: var(--rosa);
	}
	@media (max-width: 820px) {
		.menu-largo {
			display: none;
		}
		.menu-piccolo {
			display: block;
		}
	}

	main {
		min-height: 60vh;
	}

	.piede {
		margin-top: clamp(64px, 10vw, 120px);
		background: var(--rosa);
		padding: 56px 0 28px;
	}
	.piede-griglia {
		max-width: var(--larghezza);
		margin: 0 auto;
		padding: 0 var(--margine);
		display: grid;
		grid-template-columns: 1.4fr repeat(3, 1fr);
		gap: 32px;
	}
	.piede nav {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.piede nav a {
		text-decoration: none;
	}
	.piede nav a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.piede-dove {
		margin-top: 14px;
	}
	.piede-legale {
		max-width: var(--larghezza);
		margin: 48px auto 0;
		padding: 0 var(--margine);
		font-size: 0.9rem;
		color: var(--nero-tenue);
	}
	@media (max-width: 820px) {
		.piede-griglia {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 480px) {
		.piede-griglia {
			grid-template-columns: 1fr;
		}
	}
</style>
