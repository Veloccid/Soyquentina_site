---
import '@fontsource/figtree/300.css';
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import Busto from '../components/Busto.astro';
import { SITO, MENU, linkWhatsApp } from '../config';
import { trovaTema, link } from '../temi';

interface Props {
	tema: string;
	titolo?: string;
	descrizione?: string;
	immagine?: string;
}

const { tema, titolo, descrizione = SITO.descrizione, immagine = '/og-image.png' } = Astro.props;
const t = trovaTema(tema);
const titoloCompleto = titolo ? `${titolo} | ${SITO.nome}` : SITO.titolo;
const urlPagina = new URL(Astro.url.pathname, SITO.url).href;
const urlImmagine = new URL(immagine, SITO.url).href;
const percorso = Astro.url.pathname.replace(/\/$/, '');
const attivo = (href: string) => percorso.startsWith(link(tema, href)) || undefined;
const anno = new Date().getFullYear();
---

<html lang="it" data-tema={tema}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{titoloCompleto}</title>
		<meta name="description" content={descrizione} />
		<meta name="robots" content="noindex" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITO.nome} />
		<meta property="og:title" content={titoloCompleto} />
		<meta property="og:description" content={descrizione} />
		<meta property="og:url" content={urlPagina} />
		<meta property="og:image" content={urlImmagine} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="it_IT" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="salta" href="#contenuto">Vai al contenuto</a>

		{
			tema === 'wow' && (
				<div class="forno-intro" aria-hidden="true">
					<Busto altezza={120} alt="" />
					<div class="forno-barra">
						<span />
					</div>
					<p>si accende il forno</p>
				</div>
			)
		}

		<header class="testata">
			<a class="marchio" href={link(tema, '/')} aria-label="SoyQuentina, home">
				<Busto altezza={38} alt="" />
				<span>SoyQuentina</span>
			</a>

			<nav class="menu-largo" aria-label="Menu principale">
				{
					MENU.map((voce) => (
						<a href={link(tema, voce.href)} aria-current={attivo(voce.href) && 'page'}>
							{voce.testo}
						</a>
					))
				}
			</nav>

			<details class="menu-piccolo">
				<summary>Menu</summary>
				<nav aria-label="Menu principale">
					{
						MENU.map((voce) => (
							<a href={link(tema, voce.href)} aria-current={attivo(voce.href) && 'page'}>
								{voce.testo}
							</a>
						))
					}
				</nav>
			</details>
		</header>

		<main id="contenuto">
			<slot />
		</main>

		<footer class="piede">
			<div class="piede-griglia">
				<div>
					<span class="piede-logo"><Busto altezza={56} alt="" /></span>
					<p class="piede-dove">Homelab a {SITO.zona}<br />visite su appuntamento</p>
				</div>
				<nav aria-label="Pagine">
					{MENU.map((voce) => <a href={link(tema, voce.href)}>{voce.testo}</a>)}
				</nav>
				<nav aria-label="Contatti">
					<a href={SITO.instagram} target="_blank" rel="noopener">Instagram {SITO.instagramNome}</a>
					<a href={linkWhatsApp('Ciao Quentina!')} target="_blank" rel="noopener">Scrivimi su WhatsApp</a>
				</nav>
				<nav aria-label="Informazioni legali">
					<a href={link(tema, '/spedizioni-e-resi')}>Spedizioni e resi</a>
					<a href={link(tema, '/termini-di-vendita')}>Termini di vendita</a>
					<a href={link(tema, '/privacy')}>Privacy e cookie</a>
				</nav>
			</div>
			<p class="piede-legale">
				© {anno} {SITO.ragioneSociale || SITO.nome}
				{SITO.partitaIva ? ` — P.IVA ${SITO.partitaIva}` : ' — P.IVA da inserire'}
			</p>
		</footer>

		<a class="pillola-proposta" href="/">
			<span>Proposta {t.lettera}: {t.nome}</span>
			<strong>Cambia</strong>
		</a>

		{
			tema === 'wow' && (
				<script is:inline>
					(() => {
						const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
						const intro = document.querySelector('.forno-intro');
						// l'apertura "forno" solo alla prima pagina della visita
						let vista = false;
						try { vista = sessionStorage.getItem('forno') === '1'; sessionStorage.setItem('forno', '1'); } catch (e) {}
						if (intro) {
							if (ridotto || vista) intro.remove();
							else setTimeout(() => { intro.classList.add('via'); setTimeout(() => intro.remove(), 900); }, 1700);
						}

						// gli elementi entrano in scena mentre scorri
						const els = document.querySelectorAll('[data-rivela]');
						if (ridotto || !('IntersectionObserver' in window)) {
							els.forEach((el) => el.classList.add('visto'));
						} else {
							const io = new IntersectionObserver((voci) => {
								voci.forEach((v) => { if (v.isIntersecting) { v.target.classList.add('visto'); io.unobserve(v.target); } });
							}, { threshold: 0.12 });
							els.forEach((el, i) => { el.style.setProperty('--ritardo', `${(i % 4) * 90}ms`); io.observe(el); });
						}

						// le schede si inclinano seguendo il mouse
						if (!ridotto && matchMedia('(hover: hover)').matches) {
							document.querySelectorAll('.scheda').forEach((s) => {
								s.addEventListener('pointermove', (e) => {
									const r = s.getBoundingClientRect();
									const x = (e.clientX - r.left) / r.width - 0.5;
									const y = (e.clientY - r.top) / r.height - 0.5;
									s.style.transform = `perspective(700px) rotateY(${x * 10}deg) rotateX(${-y * 10}deg) translateY(-4px)`;
								});
								s.addEventListener('pointerleave', () => { s.style.transform = ''; });
							});
						}

						// le scritte che scorrono accelerano quando scorri la pagina
						const nastri = document.querySelectorAll('.nastro-scorre');
						if (!ridotto && nastri.length) {
							let ultimo = scrollY;
							let spinta = 1;
							addEventListener('scroll', () => {
								spinta = 1 + Math.min(Math.abs(scrollY - ultimo), 80) / 12;
								ultimo = scrollY;
							}, { passive: true });
							let pos = 0;
							const giro = () => {
								pos -= 0.6 * spinta;
								spinta += (1 - spinta) * 0.05;
								nastri.forEach((n) => {
									const meta = n.scrollWidth / 2;
									if (-pos > meta) pos += meta;
									n.style.transform = `translateX(${pos}px)`;
								});
								requestAnimationFrame(giro);
							};
							requestAnimationFrame(giro);
						}
					})();
				</script>
			)
		}
	</body>
</html>

<style is:global>
	:root {
		--bianco: #ffffff;
		--rosa: #fddcd7;
		--nero: #000000;
		--sfondo: var(--bianco);
		--superficie: var(--rosa);
		--testo: var(--nero);
		--nero-tenue: rgba(0, 0, 0, 0.62);
		--linea: 1.5px solid var(--nero);
		--raggio: 32px;
		--larghezza: 1180px;
		--margine: clamp(16px, 4vw, 40px);
	}
	[data-tema='rosa'] {
		--sfondo: var(--rosa);
		--superficie: var(--bianco);
	}
	[data-tema='morbida'] {
		--raggio: 44px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		background: var(--sfondo);
		color: var(--testo);
		font-family: 'Figtree', system-ui, sans-serif;
		font-weight: 300;
		font-size: 1.0625rem;
		line-height: 1.6;
	}
	img {
		max-width: 100%;
	}
	a {
		color: inherit;
	}
	h1,
	h2,
	h3 {
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0;
	}
	h1 {
		font-size: clamp(2.4rem, 6vw, 4.4rem);
	}
	h2 {
		font-size: clamp(1.8rem, 3.6vw, 2.6rem);
	}
	h3 {
		font-size: 1.3rem;
		letter-spacing: -0.01em;
	}
	p {
		margin: 0;
	}
	:focus-visible {
		outline: 2px solid var(--nero);
		outline-offset: 3px;
	}

	.contenitore {
		max-width: var(--larghezza);
		margin: 0 auto;
		padding: 0 var(--margine);
	}
	.testo-breve {
		max-width: 60ch;
	}
	.tenue {
		color: var(--nero-tenue);
	}

	.bottone {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 48px;
		padding: 0 26px;
		border-radius: 999px;
		border: var(--linea);
		background: var(--nero);
		color: var(--bianco);
		font: inherit;
		font-weight: 400;
		text-decoration: none;
		cursor: pointer;
		transition: background 0.2s, color 0.2s, transform 0.2s, box-shadow 0.2s;
	}
	.bottone:hover {
		background: var(--sfondo);
		color: var(--nero);
	}
	.bottone.chiaro {
		background: transparent;
		color: var(--nero);
	}
	.bottone.chiaro:hover {
		background: var(--nero);
		color: var(--bianco);
	}
	.bottoni {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	[data-tema='morbida'] .bottone {
		background: var(--rosa);
		color: var(--nero);
		box-shadow: 3px 3px 0 var(--nero);
	}
	[data-tema='morbida'] .bottone:hover {
		transform: translate(-2px, -2px);
		box-shadow: 5px 5px 0 var(--nero);
		background: var(--rosa);
	}
	[data-tema='morbida'] .bottone.chiaro {
		background: var(--bianco);
	}

	.salta {
		position: absolute;
		left: -9999px;
	}
	.salta:focus {
		left: 16px;
		top: 16px;
		z-index: 10;
		background: var(--bianco);
		padding: 8px 12px;
	}

	/* pillola per cambiare proposta (solo per la presentazione) */
	.pillola-proposta {
		position: fixed;
		left: 16px;
		bottom: 16px;
		z-index: 50;
		display: flex;
		gap: 10px;
		align-items: center;
		background: var(--nero);
		color: var(--bianco);
		border-radius: 999px;
		padding: 8px 8px 8px 16px;
		font-size: 0.88rem;
		text-decoration: none;
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
	}
	.pillola-proposta strong {
		font-weight: 400;
		background: var(--rosa);
		color: var(--nero);
		border-radius: 999px;
		padding: 2px 12px;
	}

	/* ===== Proposta B: Wow ===== */
	[data-tema='wow'] [data-rivela] {
		opacity: 0;
		transform: translateY(36px) scale(0.98);
		transition: opacity 0.8s ease, transform 0.9s cubic-bezier(0.2, 0.9, 0.2, 1);
		transition-delay: var(--ritardo, 0ms);
	}
	[data-tema='wow'] [data-rivela].visto {
		opacity: 1;
		transform: none;
	}
	[data-tema='wow'] main {
		overflow-x: clip;
	}
	[data-tema='wow'] .scheda {
		transition: transform 0.25s ease-out;
		will-change: transform;
	}
	.forno-intro {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: var(--rosa);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 22px;
		transition: clip-path 0.9s cubic-bezier(0.7, 0, 0.2, 1);
		clip-path: circle(150% at 50% 50%);
	}
	.forno-intro.via {
		clip-path: circle(0% at 50% 45%);
	}
	.forno-intro .busto {
		animation: forno-respira 1.2s ease-in-out infinite;
	}
	.forno-barra {
		width: 180px;
		height: 10px;
		border: var(--linea);
		border-radius: 999px;
		overflow: hidden;
		background: var(--bianco);
	}
	.forno-barra span {
		display: block;
		height: 100%;
		width: 0;
		background: var(--nero);
		animation: forno-carica 1.6s ease-in-out forwards;
	}
	.forno-intro p {
		font-size: 0.95rem;
	}
	@keyframes forno-carica {
		from {
			width: 0;
		}
		to {
			width: 100%;
		}
	}
	@keyframes forno-respira {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.06);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation: none !important;
			transition: none !important;
		}
		html {
			scroll-behavior: auto;
		}
	}
</style>

<style>
	.testata {
		max-width: var(--larghezza);
		margin: 0 auto;
		padding: 18px var(--margine);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		position: relative;
		z-index: 20;
	}
	.marchio {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		font-size: 1.35rem;
		font-weight: 400;
		letter-spacing: -0.01em;
	}
	.menu-largo {
		display: flex;
		gap: 28px;
	}
	.menu-largo a,
	.menu-piccolo a {
		text-decoration: none;
		font-weight: 400;
	}
	.menu-largo a:hover,
	.menu-largo a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 1.5px;
	}
	.menu-piccolo {
		display: none;
		position: relative;
	}
	.menu-piccolo summary {
		list-style: none;
		cursor: pointer;
		border: var(--linea);
		border-radius: 999px;
		padding: 6px 18px;
		font-weight: 400;
	}
	.menu-piccolo summary::-webkit-details-marker {
		display: none;
	}
	.menu-piccolo nav {
		position: absolute;
		right: 0;
		top: calc(100% + 10px);
		z-index: 5;
		background: var(--bianco);
		border: var(--linea);
		border-radius: 20px;
		padding: 10px 0;
		min-width: 200px;
		display: flex;
		flex-direction: column;
	}
	.menu-piccolo nav a {
		padding: 10px 22px;
	}
	.menu-piccolo nav a[aria-current='page'] {
		background: var(--rosa);
	}
	@media (max-width: 820px) {
		.menu-largo {
			display: none;
		}
		.menu-piccolo {
			display: block;
		}
	}

	/* testata: varianti */
	:global([data-tema='rosa']) .testata {
		border-bottom: var(--linea);
		max-width: none;
	}
	:global([data-tema='morbida']) .menu-largo {
		background: var(--rosa);
		border: var(--linea);
		border-radius: 999px;
		padding: 8px 22px;
		gap: 22px;
	}

	main {
		min-height: 60vh;
	}

	.piede {
		margin-top: clamp(64px, 10vw, 120px);
		background: var(--superficie);
		padding: 56px 0 0;
	}
	:global([data-tema='rosa']) .piede {
		background: var(--nero);
		color: var(--bianco);
	}
	:global([data-tema='rosa']) .piede-logo {
		display: inline-flex;
		background: var(--bianco);
		border-radius: 14px;
		padding: 8px 10px;
	}
	:global([data-tema='rosa']) .piede-legale {
		color: rgba(255, 255, 255, 0.7);
	}
	:global([data-tema='morbida']) .piede {
		border-radius: 48px 48px 0 0;
	}
	.piede-griglia {
		max-width: var(--larghezza);
		margin: 0 auto;
		padding: 0 var(--margine);
		display: grid;
		grid-template-columns: 1.4fr repeat(3, 1fr);
		gap: 32px;
	}
	.piede nav {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.piede nav a {
		text-decoration: none;
	}
	.piede nav a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.piede-dove {
		margin-top: 14px;
	}
	.piede-legale {
		max-width: var(--larghezza);
		margin: 48px auto 0;
		padding: 0 var(--margine) 80px;
		font-size: 0.9rem;
		color: var(--nero-tenue);
	}
	@media (max-width: 820px) {
		.piede-griglia {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 480px) {
		.piede-griglia {
			grid-template-columns: 1fr;
		}
	}
</style>
