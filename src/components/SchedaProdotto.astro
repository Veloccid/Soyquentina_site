---
import Foto from './Foto.astro';
import { type Prodotto, TIPI, prezzoFormattato } from '../data/prodotti';

interface Props {
	prodotto: Prodotto;
}
const { prodotto } = Astro.props;
---

<a class="scheda" href={`/prodotti/${prodotto.slug}`}>
	<Foto src={prodotto.foto[0]} alt={prodotto.nome} />
	<div class="info">
		<h3>{prodotto.nome}</h3>
		<p class="prezzo">{prezzoFormattato(prodotto.prezzo)}</p>
	</div>
	<p class="tipo tenue">{TIPI[prodotto.tipo].etichetta}{prodotto.pezzoUnico ? ', pezzo unico' : ''}</p>
	{!prodotto.disponibile && <p class="venduto">Venduto</p>}
</a>

<style>
	.scheda {
		display: flex;
		flex-direction: column;
		gap: 10px;
		text-decoration: none;
		position: relative;
	}
	.scheda :global(.foto) {
		transition: border-radius 0.35s ease;
	}
	.scheda:hover :global(.foto) {
		border-radius: 999px 999px 24px 24px;
	}
	.info {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		margin-top: 4px;
	}
	h3 {
		font-size: 1.15rem;
	}
	.prezzo {
		font-weight: 400;
		white-space: nowrap;
	}
	.tipo {
		font-size: 0.92rem;
		margin-top: -6px;
	}
	.venduto {
		position: absolute;
		top: 16px;
		left: 16px;
		background: var(--bianco);
		border: var(--linea);
		border-radius: 999px;
		padding: 2px 12px;
		font-size: 0.85rem;
	}
</style>
