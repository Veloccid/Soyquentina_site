---
// Sagoma disegnata di una ceramica: segnaposto finché non arrivano le foto.
// Quando ci saranno le foto (meglio se scontornate, senza sfondo) si mostra la foto.
interface Props {
	indice: number;
	foto?: string;
	alt: string;
}
const { indice, foto, alt } = Astro.props;

const forme = [
	// vaso
	'M38 10h24v8c0 6 14 14 18 30 5 22-4 52-14 62H34C24 100 15 70 20 48c4-16 18-24 18-30z',
	// tazza con manico
	'M18 46h56v34c0 18-12 30-28 30S18 98 18 80zM74 56c14 0 16 22 0 24',
	// ciotola
	'M8 64h84c0 24-18 44-42 44S8 88 8 64zM34 108h32',
	// bottiglia
	'M42 6h16v24c10 6 16 16 16 30v50H26V60c0-14 6-24 16-30z',
	// brocca
	'M30 26c4-12 34-14 40 0l10-6-4 14c8 10 10 30 6 48-4 18-14 28-32 28s-28-10-32-28c-4-18-2-38 6-48z',
	// vasetto basso
	'M24 40h52c6 0 10 6 10 14v30c0 16-16 26-36 26S14 100 14 84V54c0-8 4-14 10-14z',
];
const d = forme[indice % forme.length];
---

{
	foto ? (
		<img class="sagoma-foto" src={foto} alt={alt} loading="lazy" />
	) : (
		<svg class="sagoma" viewBox="0 0 100 120" role="img" aria-label={`${alt} (foto in arrivo)`}>
			<path d={d} />
		</svg>
	)
}

<style>
	.sagoma,
	.sagoma-foto {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: bottom;
	}
	.sagoma path {
		fill: var(--bianco);
		stroke: var(--nero);
		stroke-width: 2.6;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
</style>
