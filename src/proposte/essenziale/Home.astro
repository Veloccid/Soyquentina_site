---
import Layout from '../../layouts/Layout.astro';
import Busto from '../../components/Busto.astro';
import SchedaProdotto from '../../components/SchedaProdotto.astro';
import AvvisoSelezione from '../../components/AvvisoSelezione.astro';
import { PRODOTTI, TIPI } from '../../data/prodotti';
import { SITO, linkWhatsApp } from '../../config';
import { link } from '../../temi';

const tema = 'essenziale';
const inEvidenza = PRODOTTI.filter((p) => p.disponibile).slice(0, 4);
const visita = linkWhatsApp(
	'Ciao Quentina! Vorrei passare in laboratorio a vedere le ceramiche. Quando posso venire?',
);
---

<Layout tema={tema}>
	<section class="apertura contenitore">
		<div class="apertura-testo">
			<h1>Ceramiche modellate e illustrate a mano</h1>
			<p class="sottotitolo">
				Pezzi unici nati nel mio homelab a {SITO.zona}. Online ne trovi una piccola selezione,
				tutto il resto ti aspetta in laboratorio.
			</p>
			<div class="bottoni">
				<a class="bottone" href={link(tema, '/shop')}>Vai allo shop</a>
				<a class="bottone chiaro" href={visita} target="_blank" rel="noopener">Prenota una visita</a>
			</div>
		</div>
		<div class="apertura-arco" aria-hidden="true">
			<div class="respira"><Busto altezza={260} alt="" /></div>
		</div>
	</section>

	<section class="due-anime contenitore" aria-labelledby="titolo-anime">
		<h2 id="titolo-anime">Due modi di fare ceramica</h2>
		<div class="anime">
			<article>
				<h3>{TIPI.modellata.titolo}</h3>
				<p>{TIPI.modellata.spiegazione}</p>
				<a href={link(tema, '/shop#modellate')}>Vedi le ceramiche modellate a mano</a>
			</article>
			<article>
				<h3>{TIPI.illustrata.titolo}</h3>
				<p>{TIPI.illustrata.spiegazione}</p>
				<a href={link(tema, '/shop#illustrate')}>Vedi le ceramiche illustrate</a>
			</article>
		</div>
	</section>

	<section class="evidenza contenitore" aria-labelledby="titolo-evidenza">
		<div class="intestazione">
			<h2 id="titolo-evidenza">Dalla selezione online</h2>
			<a href={link(tema, '/shop')}>Tutto lo shop</a>
		</div>
		<div class="griglia">
			{inEvidenza.map((p) => <SchedaProdotto prodotto={p} tema={tema} />)}
		</div>
	</section>

	<div class="contenitore blocco">
		<AvvisoSelezione />
	</div>

	<section class="altro contenitore" aria-labelledby="titolo-altro">
		<h2 id="titolo-altro">Non solo shop</h2>
		<ul>
			<li>
				<a href={link(tema, '/laboratori')}>
					<h3>Laboratori</h3>
					<p>Mani in pasta: impara a modellare e decorare la ceramica insieme a me.</p>
				</a>
			</li>
			<li>
				<a href={link(tema, '/commissioni')}>
					<h3>Commissioni</h3>
					<p>Un pezzo pensato per te, per una casa, un regalo o un'occasione speciale.</p>
				</a>
			</li>
			<li>
				<a href={link(tema, '/gift-card')}>
					<h3>Gift card</h3>
					<p>Regala una ceramica o un laboratorio, e lascia scegliere a chi la riceve.</p>
				</a>
			</li>
		</ul>
	</section>
</Layout>

<style>
	.apertura {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		align-items: end;
		gap: clamp(32px, 6vw, 80px);
		padding-top: clamp(24px, 5vw, 64px);
	}
	.apertura-testo {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding-bottom: clamp(8px, 4vw, 48px);
	}
	.sottotitolo {
		font-size: 1.2rem;
		max-width: 42ch;
	}
	.apertura-arco {
		background: var(--rosa);
		border-radius: 999px 999px 0 0;
		aspect-ratio: 4 / 5;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-top: 10%;
	}
	.respira {
		transform-origin: 50% 100%;
		animation: respira 5s ease-in-out infinite;
	}
	@keyframes respira {
		0%,
		100% {
			transform: scale(1, 1);
		}
		50% {
			transform: scale(1.02, 1.035);
		}
	}

	.due-anime,
	.evidenza,
	.altro,
	.blocco {
		margin-top: clamp(72px, 10vw, 128px);
	}
	.anime {
		margin-top: 32px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-top: var(--linea);
	}
	.anime article {
		padding: 28px 32px 8px 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.anime article + article {
		border-left: var(--linea);
		padding-left: 32px;
	}
	.anime p {
		max-width: 44ch;
	}
	.anime a {
		font-weight: 400;
		text-underline-offset: 5px;
	}

	.intestazione {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		margin-bottom: 32px;
	}
	.intestazione a {
		white-space: nowrap;
		font-weight: 400;
		text-underline-offset: 5px;
	}
	.griglia {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 32px 24px;
	}

	.altro ul {
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		border-top: var(--linea);
	}
	.altro li {
		border-bottom: var(--linea);
	}
	.altro li a {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 16px;
		align-items: baseline;
		padding: 26px 0;
		text-decoration: none;
		transition: padding 0.25s ease, background 0.25s ease;
	}
	.altro li a:hover {
		background: var(--rosa);
		padding-left: 20px;
	}
	.altro h3 {
		font-size: clamp(1.4rem, 2.6vw, 1.9rem);
	}

	@media (max-width: 900px) {
		.griglia {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 760px) {
		.apertura {
			grid-template-columns: 1fr;
		}
		.apertura-arco {
			max-width: 360px;
			width: 100%;
			margin: 0 auto;
		}
		.anime {
			grid-template-columns: 1fr;
		}
		.anime article + article {
			border-left: 0;
			border-top: var(--linea);
			padding-left: 0;
		}
		.altro li a {
			grid-template-columns: 1fr;
			gap: 6px;
		}
	}
</style>
