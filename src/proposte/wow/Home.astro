---
import Layout from '../../layouts/Layout.astro';
import Busto from '../../components/Busto.astro';
import SchedaProdotto from '../../components/SchedaProdotto.astro';
import AvvisoSelezione from '../../components/AvvisoSelezione.astro';
import { PRODOTTI, TIPI } from '../../data/prodotti';
import { SITO, linkWhatsApp } from '../../config';
import { link } from '../../temi';

const tema = 'wow';
const scorrono = PRODOTTI.filter((p) => p.disponibile).slice(0, 8);
const visita = linkWhatsApp(
	'Ciao Quentina! Vorrei passare in laboratorio a vedere le ceramiche. Quando posso venire?',
);
const parole = ['pezzi unici', 'modellati a mano', 'illustrati a mano', 'cotti nel forno', `homelab a ${SITO.zona}`];
---

<Layout tema={tema}>
	<div class="cursore" aria-hidden="true"></div>

	<section class="eroe">
		<div class="eroe-cerchio" aria-hidden="true">
			<Busto altezza={300} alt="" />
		</div>
		<h1 class="eroe-titolo">
			<span class="riga"><span style="--d:0ms">Ceramiche</span></span>
			<span class="riga"><span style="--d:120ms">modellate e illustrate</span></span>
			<span class="riga"><span style="--d:240ms">a mano</span></span>
		</h1>
		<div class="eroe-azioni">
			<a class="bottone" href={link(tema, '/shop')}>Vai allo shop</a>
			<a class="bottone chiaro" href={visita} target="_blank" rel="noopener">Prenota una visita</a>
		</div>
		<p class="scorri" aria-hidden="true">scorri</p>
	</section>

	<div class="nastro" aria-hidden="true">
		<div class="nastro-scorre">
			{[0, 1].map(() => parole.map((p) => <span>{p}<i>✦</i></span>))}
		</div>
	</div>

	<section class="anime contenitore" aria-labelledby="titolo-anime">
		<h2 id="titolo-anime" data-rivela>Due modi di fare ceramica</h2>
		<div class="anime-coppia">
			<a class="anima" href={link(tema, '/shop#modellate')} data-rivela>
				<span class="anima-sfondo" aria-hidden="true"></span>
				<h3>{TIPI.modellata.titolo}</h3>
				<p>{TIPI.modellata.spiegazione}</p>
				<span class="anima-vai">Scopri</span>
			</a>
			<a class="anima" href={link(tema, '/shop#illustrate')} data-rivela>
				<span class="anima-sfondo" aria-hidden="true"></span>
				<h3>{TIPI.illustrata.titolo}</h3>
				<p>{TIPI.illustrata.spiegazione}</p>
				<span class="anima-vai">Scopri</span>
			</a>
		</div>
	</section>

	<section class="binario" aria-labelledby="titolo-binario">
		<div class="binario-fisso">
			<div class="contenitore binario-testa">
				<h2 id="titolo-binario">Dalla selezione online</h2>
				<a href={link(tema, '/shop')}>Tutto lo shop</a>
			</div>
			<div class="binario-pista">
				{scorrono.map((p) => (
					<div class="binario-pezzo">
						<SchedaProdotto prodotto={p} tema={tema} />
					</div>
				))}
			</div>
		</div>
	</section>

	<div class="contenitore blocco">
		<AvvisoSelezione />
	</div>

	<section class="altro contenitore" aria-labelledby="titolo-altro">
		<h2 id="titolo-altro" data-rivela>Non solo shop</h2>
		<ul>
			<li data-rivela>
				<a href={link(tema, '/laboratori')}><h3>Laboratori</h3><p>Mani in pasta: impara a modellare e decorare la ceramica insieme a me.</p></a>
			</li>
			<li data-rivela>
				<a href={link(tema, '/commissioni')}><h3>Commissioni</h3><p>Un pezzo pensato per te, per una casa, un regalo o un'occasione speciale.</p></a>
			</li>
			<li data-rivela>
				<a href={link(tema, '/gift-card')}><h3>Gift card</h3><p>Regala una ceramica o un laboratorio, e lascia scegliere a chi la riceve.</p></a>
			</li>
		</ul>
	</section>

	<script is:inline>
		(() => {
			const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
			let giaVisto = false;
			try { giaVisto = sessionStorage.getItem('forno') === '1'; } catch (e) {}
			if (!giaVisto && !ridotto && document.querySelector('.forno-intro')) document.documentElement.classList.add('con-intro');
			if (ridotto) return;

			// il cerchio rosa con il busto cresce mentre scorri
			const eroe = document.querySelector('.eroe');
			const cerchio = document.querySelector('.eroe-cerchio');
			// la fila di prodotti scorre in orizzontale mentre scorri in verticale
			const binario = document.querySelector('.binario');
			const pista = document.querySelector('.binario-pista');
			const largo = () => matchMedia('(min-width: 761px)').matches;

			const aggiorna = () => {
				const h = innerHeight;
				if (eroe && cerchio) {
					const p = Math.min(Math.max(-eroe.getBoundingClientRect().top / h, 0), 1);
					cerchio.style.transform = `translate(-50%, -50%) scale(${1 + p * 1.6})`;
					cerchio.style.opacity = String(1 - p * 0.9);
				}
				if (binario && pista) {
					if (largo()) {
						const r = binario.getBoundingClientRect();
						const corsa = binario.offsetHeight - h;
						const p = Math.min(Math.max(-r.top / corsa, 0), 1);
						const max = pista.scrollWidth - innerWidth + 80;
						pista.style.transform = `translateX(${-p * Math.max(max, 0)}px)`;
					} else {
						pista.style.transform = '';
					}
				}
			};
			const dimensiona = () => {
				if (binario && pista && largo()) {
					binario.style.height = `${pista.scrollWidth - innerWidth + innerHeight * 1.2}px`;
				} else if (binario) {
					binario.style.height = '';
				}
				aggiorna();
			};
			addEventListener('scroll', aggiorna, { passive: true });
			addEventListener('resize', dimensiona);
			addEventListener('load', dimensiona);
			dimensiona();

			// una macchia rosa segue il cursore
			const cursore = document.querySelector('.cursore');
			if (cursore && matchMedia('(hover: hover)').matches) {
				let x = innerWidth / 2, y = innerHeight / 2, cx = x, cy = y;
				addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; cursore.classList.add('attivo'); });
				document.querySelectorAll('a, button').forEach((el) => {
					el.addEventListener('pointerenter', () => cursore.classList.add('grande'));
					el.addEventListener('pointerleave', () => cursore.classList.remove('grande'));
				});
				const segui = () => {
					cx += (x - cx) * 0.14;
					cy += (y - cy) * 0.14;
					cursore.style.transform = `translate(${cx}px, ${cy}px)`;
					requestAnimationFrame(segui);
				};
				segui();
			}
		})();
	</script>
</Layout>

<style>
	.cursore {
		position: fixed;
		left: -22px;
		top: -22px;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--rosa);
		mix-blend-mode: multiply;
		pointer-events: none;
		z-index: 40;
		opacity: 0;
		transition: opacity 0.3s, width 0.3s, height 0.3s, left 0.3s, top 0.3s;
	}
	.cursore:global(.attivo) {
		opacity: 1;
	}
	.cursore:global(.grande) {
		width: 90px;
		height: 90px;
		left: -45px;
		top: -45px;
	}

	.eroe {
		position: relative;
		min-height: calc(100vh - 80px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 32px;
		padding: 40px var(--margine) 80px;
		overflow: hidden;
	}
	.eroe-cerchio {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(560px, 88vw);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--rosa);
		display: flex;
		align-items: center;
		justify-content: center;
		transform: translate(-50%, -50%);
		z-index: -1;
		animation: cerchio-entra 1.2s cubic-bezier(0.2, 1.2, 0.3, 1) both;
	}
	.eroe-cerchio :global(.busto) {
		opacity: 0.18;
	}
	.eroe-titolo {
		font-size: clamp(2.8rem, 9vw, 7.5rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
	}
	.riga {
		display: block;
		overflow: hidden;
		padding-bottom: 0.06em;
	}
	.riga span {
		display: inline-block;
		animation: sale 1s cubic-bezier(0.2, 0.9, 0.2, 1) both;
		animation-delay: calc(var(--d) + 200ms);
	}
	:global(html.con-intro) .riga span {
		animation-delay: calc(var(--d) + 2000ms);
	}
	:global(html.con-intro) .eroe-cerchio {
		animation-delay: 1.8s;
	}
	.eroe-azioni {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
		animation: appare 0.8s ease both 0.8s;
	}
	:global(html.con-intro) .eroe-azioni {
		animation-delay: 2.6s;
	}
	.scorri {
		position: absolute;
		bottom: 24px;
		font-size: 0.9rem;
		animation: ondeggia 1.6s ease-in-out infinite;
	}
	@keyframes sale {
		from {
			transform: translateY(105%);
		}
		to {
			transform: none;
		}
	}
	@keyframes appare {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes cerchio-entra {
		from {
			transform: translate(-50%, -50%) scale(0.2);
		}
		to {
			transform: translate(-50%, -50%) scale(1);
		}
	}
	@keyframes ondeggia {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(6px);
		}
	}

	.nastro {
		background: var(--nero);
		color: var(--bianco);
		overflow: hidden;
		padding: 18px 0;
		transform: rotate(-2deg);
		margin: 24px -10px 0;
	}
	.nastro-scorre {
		display: flex;
		width: max-content;
		font-size: clamp(1.4rem, 3vw, 2.2rem);
		white-space: nowrap;
	}
	.nastro-scorre span {
		display: inline-flex;
		align-items: center;
		gap: 28px;
		padding-right: 28px;
	}
	.nastro-scorre i {
		font-style: normal;
		color: var(--rosa);
	}

	.anime,
	.altro,
	.blocco {
		margin-top: clamp(80px, 12vw, 160px);
	}
	.anime-coppia {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		margin-top: 36px;
	}
	.anima {
		position: relative;
		overflow: hidden;
		border: var(--linea);
		border-radius: var(--raggio);
		padding: clamp(28px, 4vw, 48px);
		min-height: 300px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		text-decoration: none;
		isolation: isolate;
	}
	.anima-sfondo {
		position: absolute;
		width: 120px;
		height: 120px;
		right: -40px;
		bottom: -40px;
		border-radius: 50%;
		background: var(--rosa);
		z-index: -1;
		transition: transform 0.7s cubic-bezier(0.2, 0.9, 0.2, 1);
	}
	.anima:hover .anima-sfondo {
		transform: scale(9);
	}
	.anima h3 {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
	}
	.anima p {
		max-width: 38ch;
	}
	.anima-vai {
		margin-top: auto;
		font-weight: 400;
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	.binario {
		margin-top: clamp(80px, 12vw, 160px);
		position: relative;
	}
	.binario-fisso {
		position: sticky;
		top: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
		gap: 36px;
	}
	.binario-testa {
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
	}
	.binario-testa a {
		font-weight: 400;
		white-space: nowrap;
		text-underline-offset: 5px;
	}
	.binario-pista {
		display: flex;
		gap: 28px;
		padding: 0 max(var(--margine), calc((100vw - var(--larghezza)) / 2 + var(--margine)));
		will-change: transform;
	}
	.binario-pezzo {
		flex: none;
		width: clamp(240px, 24vw, 320px);
	}

	.altro ul {
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		border-top: var(--linea);
	}
	.altro li {
		border-bottom: var(--linea);
	}
	.altro li a {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 16px;
		align-items: baseline;
		padding: 30px 0;
		text-decoration: none;
		transition: padding 0.35s cubic-bezier(0.2, 0.9, 0.2, 1);
	}
	.altro li a:hover {
		padding-left: 32px;
	}
	.altro h3 {
		font-size: clamp(1.6rem, 3.4vw, 2.6rem);
	}

	@media (max-width: 760px) {
		.anime-coppia {
			grid-template-columns: 1fr;
		}
		.binario-fisso {
			position: static;
			min-height: 0;
		}
		.binario-pista {
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			padding-bottom: 12px;
		}
		.binario-pezzo {
			width: 72vw;
			scroll-snap-align: start;
		}
		.altro li a {
			grid-template-columns: 1fr;
			gap: 6px;
		}
	}
</style>
