---
import Layout from '../../layouts/Layout.astro';
import Busto from '../../components/Busto.astro';
import Foto from '../../components/Foto.astro';
import { PRODOTTI, TIPI, prezzoFormattato } from '../../data/prodotti';
import { SITO, linkWhatsApp } from '../../config';
import { link } from '../../temi';

const tema = 'flusso';
const pezzi = PRODOTTI.filter((p) => p.disponibile).slice(0, 4);
const visita = linkWhatsApp(
	'Ciao Quentina! Vorrei passare in laboratorio a vedere le ceramiche. Quando posso venire?',
);
const frase = `Pezzi unici, modellati o illustrati a mano, uno alla volta, nel mio homelab a ${SITO.zona}.`;
---

<Layout tema={tema}>
	<!-- 1. il logo grande che si rimpicciolisce mentre scorri -->
	<section class="scena apertura" data-scena style="--altezza: 180vh">
		<div class="fisso">
			<div class="logo-grande" aria-hidden="true"><Busto altezza={320} alt="" /></div>
			<h1 class="titolo">
				<span>Ceramiche</span>
				<span>fatte a mano</span>
			</h1>
			<p class="scorri" aria-hidden="true">scorri</p>
		</div>
	</section>

	<!-- 2. la frase che si accende parola per parola -->
	<section class="scena accende" data-scena style="--altezza: 220vh">
		<div class="fisso contenitore">
			<p class="frase" aria-label={frase}>
				{frase.split(' ').map((parola, i, tutte) => (
					<span aria-hidden="true" style={`--i:${i / tutte.length}`}>{parola} </span>
				))}
			</p>
		</div>
	</section>

	<!-- 3. due modi: i due pannelli arrivano da lati opposti -->
	<section class="scena due" data-scena style="--altezza: 200vh">
		<div class="fisso contenitore">
			<a class="lato sinistra" href={link(tema, '/shop#modellate')}>
				<h2>{TIPI.modellata.titolo}</h2>
				<p>{TIPI.modellata.spiegazione}</p>
			</a>
			<a class="lato destra" href={link(tema, '/shop#illustrate')}>
				<h2>{TIPI.illustrata.titolo}</h2>
				<p>{TIPI.illustrata.spiegazione}</p>
			</a>
		</div>
	</section>

	<!-- 4. i pezzi si impilano uno sull'altro -->
	<section class="pila contenitore" aria-labelledby="titolo-pila">
		<h2 id="titolo-pila" class="pila-titolo">Dalla selezione online</h2>
		{
			pezzi.map((p, i) => (
				<a class="carta" href={link(tema, `/prodotti/${p.slug}`)} style={`--n:${i}`}>
					<div class="carta-foto">
						<Foto src={p.foto[0]} alt={p.nome} />
					</div>
					<div class="carta-testo">
						<p class="carta-tipo">{TIPI[p.tipo].etichetta}</p>
						<h3>{p.nome}</h3>
						<p class="carta-prezzo">{prezzoFormattato(p.prezzo)}</p>
						<p>{p.descrizione}</p>
						<span class="carta-vai">Guarda il pezzo</span>
					</div>
				</a>
			))
		}
		<div class="pila-fine">
			<a class="bottone" href={link(tema, '/shop')}>Tutto lo shop</a>
		</div>
	</section>

	<!-- 5. il rosa si allarga a cerchio fino a riempire lo schermo -->
	<section class="scena cerchio" data-scena style="--altezza: 200vh">
		<div class="fisso">
			<div class="cerchio-rosa" aria-hidden="true"></div>
			<div class="cerchio-testo contenitore">
				<h2>Qui trovi solo una piccola selezione</h2>
				<p>
					Molte più ceramiche ti aspettano nel mio laboratorio a {SITO.zona}, su appuntamento.
					Presto anche in negozio.
				</p>
				<div class="bottoni">
					<a class="bottone" href={visita} target="_blank" rel="noopener">Prenota una visita</a>
					<a class="bottone chiaro" href={link(tema, '/laboratori')}>Laboratori</a>
					<a class="bottone chiaro" href={link(tema, '/commissioni')}>Commissioni</a>
				</div>
			</div>
		</div>
	</section>

	<script is:inline>
		(() => {
			const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const scene = [...document.querySelectorAll('[data-scena]')];
			if (ridotto) {
				document.documentElement.classList.add('flusso-fermo');
				scene.forEach((s) => s.style.setProperty('--p', '1'));
				return;
			}
			// ogni scena riceve --p da 0 a 1 in base a quanto l'hai scorsa
			let attesa = false;
			const aggiorna = () => {
				attesa = false;
				const h = innerHeight;
				scene.forEach((s) => {
					const r = s.getBoundingClientRect();
					const corsa = Math.max(s.offsetHeight - h, 1);
					const p = Math.min(Math.max(-r.top / corsa, 0), 1);
					s.style.setProperty('--p', p.toFixed(4));
				});
			};
			const chiedi = () => {
				if (!attesa) {
					attesa = true;
					requestAnimationFrame(aggiorna);
				}
			};
			addEventListener('scroll', chiedi, { passive: true });
			addEventListener('resize', chiedi);
			aggiorna();
		})();
	</script>
</Layout>

<style>
	/* ogni "scena" è alta e il suo contenuto resta fermo mentre scorri: --p va da 0 a 1 */
	.scena {
		position: relative;
		height: var(--altezza);
		--p: 0;
	}
	.fisso {
		position: sticky;
		top: 0;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	/* 1. apertura */
	.apertura .fisso {
		flex-direction: column;
		gap: 24px;
	}
	.logo-grande {
		transform: translateY(calc(var(--p) * -28vh)) scale(calc(1 - var(--p) * 0.7));
		transition: transform 0.08s linear;
	}
	.titolo {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-size: clamp(2.8rem, 9vw, 7rem);
		line-height: 0.95;
		letter-spacing: -0.045em;
		text-align: center;
	}
	.titolo span {
		display: block;
		opacity: calc(var(--p) * 3 - 0.3);
		transform: translateY(calc((1 - min(var(--p) * 2.5, 1)) * 60px));
	}
	.titolo span + span {
		opacity: calc(var(--p) * 3 - 0.9);
		transform: translateY(calc((1 - min(var(--p) * 2, 1)) * 90px));
	}
	.scorri {
		position: absolute;
		bottom: 28px;
		font-size: 0.9rem;
		opacity: calc(1 - var(--p) * 4);
		animation: ondeggia 1.6s ease-in-out infinite;
	}
	@keyframes ondeggia {
		0%,
		100% {
			translate: 0 0;
		}
		50% {
			translate: 0 6px;
		}
	}

	/* 2. frase che si accende */
	.frase {
		font-size: clamp(2rem, 5.4vw, 4.6rem);
		line-height: 1.1;
		letter-spacing: -0.035em;
		max-width: 20ch;
		margin: 0 auto;
	}
	.frase span {
		opacity: clamp(0.12, calc((var(--p) * 1.25 - var(--i)) * 8), 1);
		transition: opacity 0.15s linear;
	}

	/* 3. due pannelli che arrivano dai lati */
	.due .fisso {
		gap: 24px;
		align-items: stretch;
		padding-top: 15vh;
		padding-bottom: 15vh;
	}
	.lato {
		flex: 1;
		border: var(--linea);
		border-radius: 36px;
		padding: clamp(28px, 4vw, 56px);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 14px;
		text-decoration: none;
	}
	.lato h2 {
		font-size: clamp(2rem, 4vw, 3.4rem);
	}
	.lato p {
		max-width: 36ch;
		font-size: 1.1rem;
	}
	.sinistra {
		background: var(--rosa);
		transform: translateX(calc((1 - min(var(--p) * 1.6, 1)) * -110%));
	}
	.destra {
		transform: translateX(calc((1 - min(var(--p) * 1.6, 1)) * 110%));
	}

	/* 4. pila di carte */
	.pila {
		padding-top: 40px;
	}
	.pila-titolo {
		font-size: clamp(2.2rem, 5vw, 3.6rem);
		margin-bottom: 40px;
	}
	.carta {
		position: sticky;
		top: calc(80px + var(--n) * 22px);
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: clamp(24px, 4vw, 56px);
		align-items: center;
		background: var(--bianco);
		border: var(--linea);
		border-radius: 36px;
		padding: clamp(20px, 3vw, 36px);
		margin-bottom: 18vh;
		text-decoration: none;
		min-height: 60vh;
		box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.06);
	}
	.carta:nth-of-type(even) {
		background: var(--rosa);
	}
	.carta-foto {
		max-width: 320px;
		width: 100%;
		justify-self: center;
	}
	.carta:nth-of-type(even) .carta-foto :global(.foto) {
		background: var(--bianco);
	}
	.carta-testo {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.carta-tipo {
		font-size: 0.95rem;
	}
	.carta h3 {
		font-size: clamp(2rem, 4vw, 3.2rem);
	}
	.carta-prezzo {
		font-size: 1.4rem;
		font-weight: 400;
	}
	.carta-vai {
		font-weight: 400;
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.pila-fine {
		display: flex;
		justify-content: center;
		margin: -8vh 0 0;
	}

	/* 5. cerchio rosa che si allarga */
	.cerchio {
		margin-top: 20vh;
	}
	.cerchio-rosa {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 150vmax;
		height: 150vmax;
		border-radius: 50%;
		background: var(--rosa);
		transform: translate(-50%, -50%) scale(calc(0.04 + var(--p) * 1.3));
	}
	.cerchio-testo {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 20px;
		opacity: calc(var(--p) * 2.5 - 0.6);
		transform: translateY(calc((1 - min(var(--p) * 1.8, 1)) * 40px));
	}
	.cerchio-testo h2 {
		font-size: clamp(2.2rem, 5.4vw, 4.4rem);
		max-width: 16ch;
	}
	.cerchio-testo p {
		font-size: 1.2rem;
		max-width: 46ch;
	}
	.cerchio-testo .bottoni {
		justify-content: center;
	}

	/* senza movimento: tutto visibile e fermo */
	:global(html.flusso-fermo) .scena {
		height: auto;
	}
	:global(html.flusso-fermo) .fisso {
		position: static;
		height: auto;
		padding: 64px 0;
	}

	@media (max-width: 760px) {
		.due .fisso {
			flex-direction: column;
			padding: 12vh var(--margine);
		}
		.carta {
			grid-template-columns: 1fr;
			min-height: 0;
			top: calc(70px + var(--n) * 14px);
		}
		.carta-foto {
			max-width: 200px;
		}
	}
</style>
