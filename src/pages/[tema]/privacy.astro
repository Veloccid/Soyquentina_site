---
import Pagina from '../../components/Pagina.astro';
import { percorsiTemi } from '../../temi';

export function getStaticPaths() {
	return percorsiTemi();
}
const { tema } = Astro.params as { tema: string };

---

<Pagina tema={tema} titolo="Privacy e cookie" descrizione="Informativa privacy e cookie di SoyQuentina." daCompletare>
	<h2>Titolare del trattamento</h2>
	<p>[Nome e cognome o ragione sociale], [indirizzo], [email].</p>

	<h2>Da completare</h2>
	<ul>
		<li>Quali dati raccolgo (ordini, contatti su WhatsApp, eventuale newsletter) e perché.</li>
		<li>Servizi esterni usati: Vercel (hosting), Stripe (pagamenti), WhatsApp e Instagram (contatti).</li>
		<li>Per quanto tempo conservo i dati e i diritti di chi li fornisce.</li>
		<li>
			Cookie: al momento il sito non usa cookie di profilazione né statistiche. Se in futuro
			aggiungerai analytics o pixel, servirà un banner per il consenso.
		</li>
	</ul>
	<p class="tenue">Questo testo va scritto o verificato da un professionista prima di vendere online.</p>
</Pagina>
