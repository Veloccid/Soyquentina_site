---
import Pagina from '../../components/Pagina.astro';
import { SITO } from '../../config';
import { percorsiTemi } from '../../temi';

export function getStaticPaths() {
	return percorsiTemi();
}
const { tema } = Astro.params as { tema: string };

---

<Pagina tema={tema} titolo="Termini di vendita" descrizione="Condizioni generali di vendita di SoyQuentina." daCompletare>
	<h2>Chi vende</h2>
	<p>
		{SITO.ragioneSociale || '[Nome e cognome o ragione sociale]'}, {SITO.partitaIva ? `P.IVA ${SITO.partitaIva}` : '[P.IVA]'},
		[indirizzo], [email].
	</p>

	<h2>Da completare</h2>
	<ul>
		<li>Prezzi (IVA inclusa o regime forfettario) e metodi di pagamento.</li>
		<li>Conclusione del contratto e conferma d'ordine.</li>
		<li>Spedizione, consegna e passaggio del rischio.</li>
		<li>Diritto di recesso e garanzia legale di conformità.</li>
		<li>Prodotti artigianali: variazioni di forma e colore rispetto alle foto.</li>
		<li>Legge applicabile e risoluzione delle controversie (piattaforma ODR).</li>
	</ul>
	<p class="tenue">Questo testo va scritto o verificato da un professionista prima di vendere online.</p>
</Pagina>
