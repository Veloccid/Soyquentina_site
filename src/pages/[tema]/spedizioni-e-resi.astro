---
import Pagina from '../../components/Pagina.astro';
import { percorsiTemi } from '../../temi';

export function getStaticPaths() {
	return percorsiTemi();
}
const { tema } = Astro.params as { tema: string };

---

<Pagina tema={tema} titolo="Spedizioni e resi" descrizione="Come spedisco le ceramiche SoyQuentina e come funzionano i resi." daCompletare>
	<h2>Spedizioni</h2>
	<ul>
		<li>Paesi in cui spedisco: da definire (es. solo Italia).</li>
		<li>Corriere e costi: da definire.</li>
		<li>Tempi di preparazione e consegna: da definire.</li>
		<li>Ogni ceramica viene imballata a mano con materiale protettivo.</li>
	</ul>

	<h2>Ritiro in laboratorio</h2>
	<p>Puoi ritirare gratuitamente il tuo ordine nel laboratorio a Garbatella, su appuntamento.</p>

	<h2>Pezzi arrivati rotti</h2>
	<p>Da definire: entro quanti giorni segnalarlo e con quali foto.</p>

	<h2>Diritto di recesso e resi</h2>
	<p>
		Da completare. Per gli acquisti online in Italia il cliente ha di norma 14 giorni per
		recedere (Codice del Consumo): il testo va verificato con un professionista, soprattutto per
		i pezzi personalizzati su commissione.
	</p>
</Pagina>
