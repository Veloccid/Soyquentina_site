---
// Pagina di scelta: elenca le proposte grafiche da mostrare alla cliente.
import '@fontsource/figtree/300.css';
import '@fontsource/figtree/400.css';
import Busto from '../components/Busto.astro';
import { TEMI } from '../temi';
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>SoyQuentina · Proposte per il sito</title>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<main>
			<header>
				<Busto altezza={72} alt="SoyQuentina" />
				<h1>Proposte per il sito</h1>
				<p>
					Più versioni dello stesso sito: stessi colori, stesso logo, stessi testi, cambiano
					impaginazione e movimento. Aprile, navigale come un sito vero e scegli quella che ti
					somiglia di più (o i pezzi che ti piacciono di ognuna).
				</p>
			</header>

			<ol>
				{
					TEMI.map((t) => (
						<li>
							<a href={`/${t.id}/`}>
								<span class="lettera">{t.lettera}</span>
								<span class="nome">{t.nome}</span>
								<span class="idea">{t.idea}</span>
								<span class="apri">Apri la proposta</span>
							</a>
						</li>
					))
				}
			</ol>

			<p class="nota">
				Prodotti, prezzi e foto sono segnaposto: le foto vere arriveranno con il servizio fotografico.
			</p>
		</main>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		background: #ffffff;
		color: #000000;
		font-family: 'Figtree', system-ui, sans-serif;
		font-weight: 300;
		line-height: 1.55;
	}
</style>

<style>
	main {
		max-width: 1080px;
		margin: 0 auto;
		padding: 48px clamp(16px, 4vw, 40px) 80px;
	}
	header {
		display: flex;
		flex-direction: column;
		gap: 18px;
		margin-bottom: 48px;
	}
	h1 {
		font-weight: 400;
		font-size: clamp(2.4rem, 6vw, 4rem);
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0;
	}
	header p {
		font-size: 1.15rem;
		max-width: 58ch;
		margin: 0;
	}
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1.5px solid #000;
	}
	li {
		border-bottom: 1.5px solid #000;
	}
	a {
		display: grid;
		grid-template-columns: 64px 220px 1fr auto;
		gap: 16px 24px;
		align-items: center;
		padding: 26px 12px;
		text-decoration: none;
		color: inherit;
		transition: background 0.2s, padding 0.2s;
	}
	a:hover {
		background: #fddcd7;
		padding-left: 24px;
	}
	a:focus-visible {
		outline: 2px solid #000;
		outline-offset: -2px;
	}
	.lettera {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #fddcd7;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: 400;
		font-size: 1.2rem;
	}
	a:hover .lettera {
		background: #fff;
	}
	.nome {
		font-size: 1.6rem;
		font-weight: 400;
		letter-spacing: -0.01em;
	}
	.idea {
		max-width: 52ch;
	}
	.apri {
		border: 1.5px solid #000;
		border-radius: 999px;
		padding: 8px 18px;
		font-weight: 400;
		white-space: nowrap;
	}
	.nota {
		margin-top: 32px;
		color: rgba(0, 0, 0, 0.62);
	}
	@media (max-width: 760px) {
		a {
			grid-template-columns: 56px 1fr;
		}
		.idea,
		.apri {
			grid-column: 2;
		}
		.apri {
			justify-self: start;
		}
	}
</style>
