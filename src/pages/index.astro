---
import '@fontsource/figtree/300.css';
import '@fontsource/figtree/400.css';
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>SoyQuentina | ceramica e altre cose</title>
		<meta name="description" content="Perlopiù illustro sulla ceramica. Laboratori e commissioni, homelab a Garbatella (Roma)." />
		<meta name="robots" content="noindex" />

		<!-- Anteprima quando il link viene condiviso (WhatsApp, Facebook, Instagram, Telegram...) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="SoyQuentina" />
		<meta property="og:title" content="SoyQuentina | ceramica e altre cose" />
		<meta property="og:description" content="Perlopiù illustro sulla ceramica. Laboratori e commissioni, homelab a Garbatella (Roma)." />
		<meta property="og:url" content="https://www.soyquentina.com/" />
		<meta property="og:image" content="https://www.soyquentina.com/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Logo SoyQuentina" />
		<meta property="og:locale" content="it_IT" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>

		<main>

			<div class="forno">
				<svg class="calore" viewBox="0 0 120 70" aria-hidden="true">
					<path d="M30 68 C 20 55, 40 45, 30 32 S 40 10, 30 2" />
					<path d="M60 68 C 50 55, 70 45, 60 32 S 70 10, 60 2" />
					<path d="M90 68 C 80 55, 100 45, 90 32 S 100 10, 90 2" />
				</svg>
				<!-- logo "nel forno": aria calda che lo fa tremolare + respiro lento -->
				<svg class="cuoce" viewBox="100 20 340 500" role="img" aria-label="SoyQuentina">
					<defs>
						<filter id="aria-calda" x="-10%" y="-10%" width="120%" height="120%">
							<feTurbulence type="fractalNoise" baseFrequency="0.004 0.018" numOctaves="1" seed="3" result="rumore">
								<animate attributeName="baseFrequency" dur="9s" values="0.004 0.018;0.006 0.026;0.004 0.018" repeatCount="indefinite" />
							</feTurbulence>
							<feDisplacementMap in="SourceGraphic" in2="rumore" scale="4" xChannelSelector="R" yChannelSelector="G" />
						</filter>
					</defs>
					<image href="/brand/logo.png" x="0" y="0" width="540" height="540" filter="url(#aria-calda)" />
				</svg>
			</div>

			<div class="barra" role="progressbar" aria-label="Cottura in corso"><span></span></div>
			<p class="cottura">cottura in corso<span class="puntini"><i>.</i><i>.</i><i>.</i></span></p>

			<p class="presto" aria-label="Torna a trovarci presto">
				{'Torna a trovarci presto'.split('').map((c, i) => (
					<span style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>
				))}
			</p>

			<p class="insta">
				Nel frattempo vai su Instagram:{' '}
				<a href="https://www.instagram.com/soyquentina/" target="_blank" rel="noopener">@soyquentina</a>
			</p>
		</main>

		<style is:global>
			:root {
				--nero: #000000;
				--bianco: #ffffff;
				--blu: #006ccf;
			}
			* { box-sizing: border-box; }
			html, body { margin: 0; height: 100%; }
			body {
				background: var(--bianco);
				color: var(--nero);
				font-family: 'Figtree', system-ui, sans-serif;
				font-weight: 300;
				text-align: center;
				overflow-x: hidden;
			}

			main {
				position: relative;
				z-index: 1;
				min-height: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 40px 16px;
			}

			.forno { position: relative; margin-top: 70px; }
			.cuoce {
				display: block;
				width: 150px;
				height: auto;
				transform-origin: 50% 100%;
				animation: respira 4.5s ease-in-out infinite;
			}
			.calore {
				position: absolute;
				left: 50%;
				bottom: 100%;
				margin-bottom: 6px;
				width: 80px;
				transform: translateX(-50%);
				overflow: visible;
			}
			.calore path {
				fill: none;
				stroke: var(--nero);
				stroke-width: 3;
				stroke-linecap: round;
				stroke-dasharray: 90;
				stroke-dashoffset: 90;
				animation: sale 2.2s ease-in-out infinite;
			}
			.calore path:nth-child(2) { animation-delay: 0.5s; }
			.calore path:nth-child(3) { animation-delay: 1s; }

			.barra {
				width: min(240px, 66vw);
				height: 14px;
				margin-top: 18px;
				border: 2px solid var(--nero);
				border-radius: 999px;
				overflow: hidden;
				background: var(--bianco);
			}
			.barra span {
				display: block;
				height: 100%;
				background: var(--blu);
				border-radius: 999px;
				animation: cuoce 14s ease-in-out infinite;
			}
			.cottura { margin: 10px 0 0; font-size: 1.05rem; letter-spacing: 0.02em; }
			.puntini i { font-style: normal; animation: puntino 2.4s infinite; }
			.puntini i:nth-child(2) { animation-delay: 0.4s; }
			.puntini i:nth-child(3) { animation-delay: 0.8s; }

			.presto {
				margin: 28px 0 0;
				font-size: clamp(1.5rem, 5.5vw, 2rem);
				color: var(--blu);
			}
			.presto span {
				display: inline-block;
				animation: onda 2.6s ease-in-out infinite;
				animation-delay: calc(var(--i) * 0.07s);
			}

			.insta { margin: 18px 0 0; font-size: 1.05rem; }
			.insta a {
				color: var(--nero);
				font-weight: 400;
				text-decoration: underline;
				text-decoration-color: var(--blu);
				text-decoration-thickness: 2px;
				text-underline-offset: 4px;
			}
			.insta a:hover { color: var(--blu); }

			@keyframes entra {
				from { opacity: 0; transform: translateY(-12px); }
				to { opacity: 1; transform: translateY(0); }
			}
			@keyframes respira {
				0%, 100% { transform: scale(1, 1); }
				50% { transform: scale(1.025, 1.04); }
			}
			@keyframes sale {
				0% { stroke-dashoffset: 90; opacity: 0; transform: translateY(8px); }
				30% { opacity: 1; }
				100% { stroke-dashoffset: -90; opacity: 0; transform: translateY(-10px); }
			}
			@keyframes cuoce {
				0% { width: 6%; }
				85%, 100% { width: 100%; }
			}
			@keyframes puntino {
				0%, 60%, 100% { opacity: 0.15; }
				30% { opacity: 1; }
			}
			@keyframes onda {
				0%, 40%, 100% { transform: translateY(0); }
				20% { transform: translateY(-7px); }
			}

			@media (max-width: 600px) {
			}
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after { animation: none !important; }
				.barra span { width: 60%; }
				.calore { display: none; }
				.cuoce image { filter: none; }
			}
		</style>
	</body>
</html>
