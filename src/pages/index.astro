---
import '@fontsource/patrick-hand';
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>SoyQuentina</title>
		<meta name="description" content="SoyQuentina — torna a trovarci presto!" />
		<meta name="robots" content="noindex" />
	</head>
	<body>

		<main>
			<!-- Logo 2: il file è quadrato con molto bianco, qui mostro solo la parte centrale -->
			<div class="logo">
				<img src="/brand/logo-2.svg" alt="SoyQuentina" width="810" height="810" />
			</div>

			<div class="forno">
				<svg class="calore" viewBox="0 0 120 70" aria-hidden="true">
					<path d="M30 68 C 20 55, 40 45, 30 32 S 40 10, 30 2" />
					<path d="M60 68 C 50 55, 70 45, 60 32 S 70 10, 60 2" />
					<path d="M90 68 C 80 55, 100 45, 90 32 S 100 10, 90 2" />
				</svg>
				<img class="vaso" src="/brand/grafiche-giusi.svg" alt="" width="130" height="130" />
			</div>

			<div class="barra" role="progressbar" aria-label="Cottura in corso"><span></span></div>
			<p class="cottura">cottura in corso<span class="puntini"><i>.</i><i>.</i><i>.</i></span></p>

			<p class="presto" aria-label="Torna a trovarci presto">
				{'Torna a trovarci presto'.split('').map((c, i) => (
					<span style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>
				))}
			</p>
		</main>

		<style is:global>
			:root {
				--nero: #000000;
				--bianco: #ffffff;
				--blu: #006ccf;
			}
			* { box-sizing: border-box; }
			html, body { margin: 0; height: 100%; }
			body {
				background: var(--bianco);
				color: var(--nero);
				font-family: 'Patrick Hand', system-ui, sans-serif;
				text-align: center;
				overflow-x: hidden;
			}

			main {
				position: relative;
				z-index: 1;
				min-height: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 40px 16px;
			}

			/* ritaglio del Logo 2 (il disegno occupa la fascia centrale del file) */
			.logo {
				--w: 250px;
				width: calc(var(--w) * 0.9);
				height: calc(var(--w) * 0.39);
				overflow: hidden;
				animation: entra 1s cubic-bezier(0.2, 1.4, 0.4, 1) both;
			}
			.logo img {
				display: block;
				width: var(--w);
				height: var(--w);
				margin-left: calc(var(--w) * -0.075);
				margin-top: calc(var(--w) * -0.29);
			}

			.forno { position: relative; margin-top: 70px; }
			.vaso {
				display: block;
				width: 130px;
				height: auto;
				transform-origin: 50% 90%;
				animation: dondola 2.4s ease-in-out infinite;
			}
			.calore {
				position: absolute;
				left: 50%;
				bottom: 92%;
				width: 80px;
				transform: translateX(-50%);
				overflow: visible;
			}
			.calore path {
				fill: none;
				stroke: var(--nero);
				stroke-width: 3;
				stroke-linecap: round;
				stroke-dasharray: 90;
				stroke-dashoffset: 90;
				animation: sale 2.2s ease-in-out infinite;
			}
			.calore path:nth-child(2) { animation-delay: 0.5s; }
			.calore path:nth-child(3) { animation-delay: 1s; }

			.barra {
				width: min(240px, 66vw);
				height: 14px;
				margin-top: 18px;
				border: 2px solid var(--nero);
				border-radius: 999px;
				overflow: hidden;
				background: var(--bianco);
			}
			.barra span {
				display: block;
				height: 100%;
				background: var(--blu);
				border-radius: 999px;
				animation: cuoce 14s ease-in-out infinite;
			}
			.cottura { margin: 8px 0 0; font-size: 1.25rem; }
			.puntini i { font-style: normal; animation: puntino 2.4s infinite; }
			.puntini i:nth-child(2) { animation-delay: 0.4s; }
			.puntini i:nth-child(3) { animation-delay: 0.8s; }

			.presto {
				margin: 28px 0 0;
				font-size: clamp(1.6rem, 6vw, 2.2rem);
				color: var(--blu);
			}
			.presto span {
				display: inline-block;
				animation: onda 2.6s ease-in-out infinite;
				animation-delay: calc(var(--i) * 0.07s);
			}

			@keyframes entra {
				from { opacity: 0; transform: translateY(-12px); }
				to { opacity: 1; transform: translateY(0); }
			}
			@keyframes dondola {
				0%, 100% { transform: rotate(-5deg); }
				50% { transform: rotate(5deg); }
			}
			@keyframes sale {
				0% { stroke-dashoffset: 90; opacity: 0; transform: translateY(8px); }
				30% { opacity: 1; }
				100% { stroke-dashoffset: -90; opacity: 0; transform: translateY(-10px); }
			}
			@keyframes cuoce {
				0% { width: 6%; }
				85%, 100% { width: 100%; }
			}
			@keyframes puntino {
				0%, 60%, 100% { opacity: 0.15; }
				30% { opacity: 1; }
			}
			@keyframes onda {
				0%, 40%, 100% { transform: translateY(0); }
				20% { transform: translateY(-7px); }
			}

			@media (max-width: 600px) {
				.logo { --w: 210px; }
			}
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after { animation: none !important; }
				.barra span { width: 60%; }
				.calore { display: none; }
			}
		</style>
	</body>
</html>
