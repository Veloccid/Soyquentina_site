---
import Layout from '../layouts/Layout.astro';
import Busto from '../components/Busto.astro';
---

<Layout tema="essenziale" titolo="Pagina non trovata">
	<section class="contenitore non-trovata">
		<Busto altezza={140} alt="" />
		<h1>Questa pagina non esiste</h1>
		<p>Forse il link è sbagliato o il pezzo non è più online.</p>
		<div class="bottoni">
			<a class="bottone" href="/">Torna alle proposte</a>
		</div>
	</section>
</Layout>

<style>
	.non-trovata {
		padding-top: 64px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 20px;
	}
	.bottoni {
		justify-content: center;
	}
</style>
