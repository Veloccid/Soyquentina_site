---
import Layout from '../../layouts/Layout.astro';
import Foto from '../../components/Foto.astro';
import SchedaProdotto from '../../components/SchedaProdotto.astro';
import AvvisoSelezione from '../../components/AvvisoSelezione.astro';
import { PRODOTTI, TIPI, prezzoFormattato, type Prodotto } from '../../data/prodotti';
import { linkWhatsApp } from '../../config';

export function getStaticPaths() {
	return PRODOTTI.map((prodotto) => ({ params: { slug: prodotto.slug }, props: { prodotto } }));
}

interface Props {
	prodotto: Prodotto;
}
const { prodotto } = Astro.props;
const altri = PRODOTTI.filter((p) => p.slug !== prodotto.slug && p.disponibile).slice(0, 4);
const chiedi = linkWhatsApp(`Ciao Quentina! Mi interessa "${prodotto.nome}". È ancora disponibile?`);
---

<Layout titolo={prodotto.nome} descrizione={prodotto.descrizione} immagine={prodotto.foto[0]}>
	<div class="contenitore">
		<a class="indietro" href={`/shop#${prodotto.tipo === 'modellata' ? 'modellate' : 'illustrate'}`}>
			Torna allo shop
		</a>
	</div>

	<article class="contenitore prodotto">
		<div class="galleria">
			<Foto src={prodotto.foto[0]} alt={prodotto.nome} grande />
			{
				prodotto.foto.length > 1 && (
					<div class="miniature">
						{prodotto.foto.slice(1).map((f, i) => (
							<img src={f} alt={`${prodotto.nome}, foto ${i + 2}`} loading="lazy" />
						))}
					</div>
				)
			}
		</div>

		<div class="dettagli">
			<p class="tipo">{TIPI[prodotto.tipo].etichetta}</p>
			<h1>{prodotto.nome}</h1>
			<p class="prezzo">{prezzoFormattato(prodotto.prezzo)}</p>
			<p class="descrizione">{prodotto.descrizione}</p>

			<dl>
				<div>
					<dt>Misure</dt>
					<dd>{prodotto.dimensioni}</dd>
				</div>
				<div>
					<dt>Peso</dt>
					<dd>{prodotto.peso}</dd>
				</div>
				<div>
					<dt>Disponibilità</dt>
					<dd>
						{prodotto.disponibile ? (prodotto.pezzoUnico ? 'Pezzo unico, 1 disponibile' : 'Disponibile') : 'Venduto'}
					</dd>
				</div>
			</dl>

			<div class="acquisto">
				<a class="bottone" href={chiedi} target="_blank" rel="noopener">Chiedi su WhatsApp</a>
				<p class="tenue">Il pagamento online arriva a breve.</p>
			</div>

			<p class="nota tenue">
				Essendo fatto a mano, il pezzo può avere piccole irregolarità: fanno parte del suo carattere.
			</p>
		</div>
	</article>

	<div class="contenitore blocco">
		<AvvisoSelezione compatto />
	</div>

	{
		altri.length > 0 && (
			<section class="contenitore blocco" aria-labelledby="titolo-altri">
				<h2 id="titolo-altri">Potrebbero piacerti</h2>
				<div class="griglia">
					{altri.map((p) => (
						<SchedaProdotto prodotto={p} />
					))}
				</div>
			</section>
		)
	}
</Layout>

<style>
	.indietro {
		display: inline-block;
		margin-top: 16px;
		font-weight: 400;
		text-underline-offset: 5px;
	}
	.prodotto {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(32px, 6vw, 80px);
		margin-top: 28px;
		align-items: start;
	}
	.miniature {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px;
		margin-top: 12px;
	}
	.miniature img {
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 16px;
		width: 100%;
	}
	.dettagli {
		display: flex;
		flex-direction: column;
		gap: 18px;
		position: sticky;
		top: 24px;
	}
	.tipo {
		align-self: flex-start;
		background: var(--rosa);
		border-radius: 999px;
		padding: 4px 14px;
		font-size: 0.92rem;
		font-weight: 400;
	}
	.prezzo {
		font-size: 1.6rem;
		font-weight: 400;
	}
	.descrizione {
		max-width: 52ch;
	}
	dl {
		margin: 8px 0 0;
		border-top: var(--linea);
	}
	dl div {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 12px;
		padding: 12px 0;
		border-bottom: var(--linea);
	}
	dt {
		font-weight: 400;
	}
	dd {
		margin: 0;
	}
	.acquisto {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		margin-top: 8px;
	}
	.nota {
		font-size: 0.95rem;
	}
	.blocco {
		margin-top: clamp(64px, 9vw, 112px);
	}
	.blocco h2 {
		margin-bottom: 32px;
	}
	.griglia {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 32px 24px;
	}
	@media (max-width: 900px) {
		.griglia {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 760px) {
		.prodotto {
			grid-template-columns: 1fr;
		}
		.galleria {
			max-width: 460px;
		}
		.dettagli {
			position: static;
		}
		dl div {
			grid-template-columns: 110px 1fr;
		}
	}
</style>
